<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_paper"
    android:layout_marginBottom="10dp"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/doc_badge"
        style="@style/Badge.DocType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PDF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/doc_title"
            style="@style/Title.Ornament"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tytuł dokumentu" />

        <TextView
            android:id="@+id/doc_subtitle"
            style="@style/Meta.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="typ · rozmiar · kategoria" />
    </LinearLayout>

    <TextView
        android:id="@+id/doc_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textSize="20sp"
        android:textColor="@color/gold"
        android:visibility="invisible" />
</LinearLayout>
