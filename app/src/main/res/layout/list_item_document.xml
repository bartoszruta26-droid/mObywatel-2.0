<?xml version="1.0" encoding="utf-8"?>
<!-- Karta dokumentu w portfelu — styl „papier urzędowy” -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_document_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/czerwien_herbowa"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
       
        android:text="DOWÓD OSOBISTY" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Dowód osobisty — wzór podglądowy" />

    <TextView
        android:id="@+id/textValidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#5F5F5F"
        android:text="Wydany: 2022-03-15 • Ważny do: 2032-03-15" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textSerial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.MojeDokumenty.Serial"
            android:text="ABC 123456" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bordowy_gov"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="Aktywny" />
    </LinearLayout>
</LinearLayout>
