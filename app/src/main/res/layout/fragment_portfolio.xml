<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <TextView
        android:id="@+id/headerPortfolio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/portfolio_header"
        android:textAppearance="@style/TextAppearance.MojeDokumenty.Header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Wzór urzędowy: małe godło w nagłówku listy -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="47dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/godlo_orla"
        app:layout_constraintTop_toTopOf="@id/headerPortfolio"
        app:layout_constraintBottom_toBottomOf="@id/headerPortfolio"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Wyszukiwarka dokumentów (tytuł / numer seryjny / typ) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchBox"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/portfolio_search_hint"
        app:startIconDrawable="@drawable/ic_viewer"
        app:layout_constraintTop_toBottomOf="@id/headerPortfolio">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchDocuments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDocuments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/searchBox"
        app:layout_constraintBottom_toTopOf="@id/buttonAddDocument" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAddDocument"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/portfolio_add"
        app:icon="@drawable/ic_viewer"
        app:layout_constraintBottom_toTopOf="@id/footerOfficial" />

    <TextView
        android:id="@+id/footerOfficial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:text="@string/official_footer"
        android:textColor="#8A8A8A"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/portfolio_empty"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerDocuments"
        app:layout_constraintBottom_toBottomOf="@id/recyclerDocuments"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
