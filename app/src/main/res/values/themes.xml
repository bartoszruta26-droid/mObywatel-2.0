<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Motyw „urzędowy”: jasne tło papierowe, akcent bordowy herbowy -->
    <style name="Theme.MojeDokumenty" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bordowy_gov</item>
        <item name="colorSecondary">@color/czerwien_herbowa</item>
        <item name="colorTertiary">@color/granat_ue</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@color/bordowy_gov</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialCardViewStyle">@style/Widget.MojeDokumenty.Card</item>
    </style>

    <style name="Theme.MojeDokumenty.Splash" parent="Theme.MojeDokumenty">
        <item name="android:windowBackground">@color/bordowy_gov</item>
    </style>

    <!-- Karty dokumentów w stylu urzędowym (ramka + cień papieru) -->
    <style name="Widget.MojeDokumenty.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeColor">@color/czerwien_herbowa</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">6dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="TextAppearance.MojeDokumenty.Header" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/bordowy_gov</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MojeDokumenty.Serial" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.15</item>
    </style>
</resources>
